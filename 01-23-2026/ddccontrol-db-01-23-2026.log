linguas="fr ru zh_CN pl es "; \
for lang in $linguas; do \
  dir=/usr/share/locale/$lang/LC_MESSAGES; \
  /bin/sh /blfs/builds/ddccontrol-db-20260120/install-sh -d $dir; \
  if test -r $lang.gmo; then \
    /usr/bin/install -c -m 644 $lang.gmo $dir/ddccontrol-db.mo; \
    echo "installing $lang.gmo as $dir/ddccontrol-db.mo"; \
  else \
    /usr/bin/install -c -m 644 ./$lang.gmo $dir/ddccontrol-db.mo; \
    echo "installing ./$lang.gmo as" \
	 "$dir/ddccontrol-db.mo"; \
  fi; \
  if test -r $lang.gmo.m; then \
    /usr/bin/install -c -m 644 $lang.gmo.m $dir/ddccontrol-db.mo.m; \
    echo "installing $lang.gmo.m as $dir/ddccontrol-db.mo.m"; \
  else \
    if test -r ./$lang.gmo.m ; then \
      /usr/bin/install -c -m 644 ./$lang.gmo.m \
	$dir/ddccontrol-db.mo.m; \
      echo "installing ./$lang.gmo.m as" \
	   "$dir/ddccontrol-db.mo.m"; \
    else \
      true; \
    fi; \
  fi; \
done
