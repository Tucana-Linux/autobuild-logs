  for f in texi2any_internals.info texi2any_internals.info-[0-9] texi2any_internals.info-[0-9][0-9] texi2any_internals.i[0-9] texi2any_internals.i[0-9][0-9]; do \
    if test -f $f; then mv $f $backupdir; restore=mv; else :; fi; \
  done; \
else :; fi && \
if TEXINFO_DEV_SOURCE=1 top_srcdir="../.." top_builddir="../.." /usr/bin/perl ../../tp/texi2any.pl -c INFO_SPECIAL_CHARS_WARNING=0 -c TREE_TRANSFORMATIONS=complete_tree_nodes_menus  -I . \
