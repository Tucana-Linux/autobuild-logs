linguas="cs de es fr pl ru zh_CN "; \
for lang in $linguas; do \
  dir=/pkgs/ddccontrol/usr/share/locale/$lang/LC_MESSAGES; \
  /bin/sh /blfs/builds/ddccontrol-1.0.3/install-sh -d $dir; \
  if test -r $lang.gmo; then \
    /usr/bin/install -c -m 644 $lang.gmo $dir/ddccontrol.mo; \
    echo "installing $lang.gmo as $dir/ddccontrol.mo"; \
  else \
    /usr/bin/install -c -m 644 ./$lang.gmo $dir/ddccontrol.mo; \
    echo "installing ./$lang.gmo as" \
	 "$dir/ddccontrol.mo"; \
  fi; \
  if test -r $lang.gmo.m; then \
    /usr/bin/install -c -m 644 $lang.gmo.m $dir/ddccontrol.mo.m; \
    echo "installing $lang.gmo.m as $dir/ddccontrol.mo.m"; \
  else \
    if test -r ./$lang.gmo.m ; then \
      /usr/bin/install -c -m 644 ./$lang.gmo.m \
	$dir/ddccontrol.mo.m; \
      echo "installing ./$lang.gmo.m as" \
	   "$dir/ddccontrol.mo.m"; \
    else \
      true; \
    fi; \
  fi; \
done
