  msgid_bugs_address='https://gitlab.freedesktop.org/fontconfig/fontconfig/issues/new'; \
else \
  msgid_bugs_address='https://gitlab.freedesktop.org/fontconfig/fontconfig/issues/new'; \
fi; \
case `/usr/bin/xgettext --version | sed 1q | sed -e 's,^[^0-9]*,,'` in \
  '' | 0.[0-9] | 0.[0-9].* | 0.1[0-5] | 0.1[0-5].* | 0.16 | 0.16.[0-1]*) \
    /usr/bin/xgettext --default-domain=fontconfig --directory=.. \
      --add-comments=TRANSLATORS: --keyword=_ --keyword=N_  \
      --files-from=./POTFILES.in \
      --copyright-holder='Fontconfig Author(s)' \
      --msgid-bugs-address="$msgid_bugs_address" \
    ;; \
  *) \
    /usr/bin/xgettext --default-domain=fontconfig --directory=.. \
      --add-comments=TRANSLATORS: --keyword=_ --keyword=N_  \
      --files-from=./POTFILES.in \
      --copyright-holder='Fontconfig Author(s)' \
      --package-name="${package_prefix}fontconfig" \
      --package-version='2.17.1' \
      --msgid-bugs-address="$msgid_bugs_address" \
    ;; \
esac
