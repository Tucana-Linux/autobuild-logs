            test -f $sf || sf=./$sf; \
            of=`echo "$f" | sed -e 's,^.*/,,' -e 's,^libtextstyle_la-,,' -e 's,\\.[^.]*$,,'`.o; \
            echo "gcc -m32 -DHAVE_CONFIG_H -I. -I..  -Iglib -DIN_LIBTEXTSTYLE -DLIBXML_STATIC    -I./libcroco  -DDEPENDS_ON_LIBICONV=1   -O2  -w -fno-analyzer -c $sf" 1>&6; \
